{
  "description": "Seny safety rails: never push, and the seny:reviewer agent stays read-only.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
